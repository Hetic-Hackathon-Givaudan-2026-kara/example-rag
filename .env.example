# --- Modèles ---
LLM_MODEL=qwen2.5:1.5b-instruct-q4_K_M
EMBED_MODEL=nomic-embed-text
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT_S=30
OLLAMA_MAX_RETRIES=1
LLM_TEMPERATURE=0
# real = vrai Ollama ; fake = réponses fixes (pour le front et les tests légers)
LLM_MODE=real

# --- Données ---
CATALOG_PATH=./data/raw_catalog.json
CHROMA_DIR=./chroma_db
COLLECTION_FLAVORS=catalog_flavors
COLLECTION_FRAGRANCES=catalog_fragrances

# --- Garde-fous (à calibrer plus tard sur le jeu de test) ---
# 0.0 = accepte tout, valeur provisoire tant qu'on n'a pas mesuré
SIMILARITY_THRESHOLD=0.0
MAX_REFERENCES=3
MAX_QUESTIONS=3

# --- API ---
# Adresses autorisées, séparées par des virgules
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
